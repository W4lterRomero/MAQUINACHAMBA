# Máquina de Chamba - Configuration Example
# Copy to .env and fill in your values
# NEVER commit .env to version control

# === Application ===
APP_ENV=development
APP_SECRET_KEY=  # Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=America/Mexico_City

# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./data/maquinachamba.db

# === AI Provider (BYOK - Bring Your Own Key) ===
# Uncomment ONE provider
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_PROVIDER=google
# GOOGLE_API_KEY=

# === AI Budget ===
AI_MONTHLY_BUDGET_USD=10.00
AI_MAX_TOKENS_PER_REQUEST=4096
AI_MAX_CONCURRENT_REQUESTS=2

# === Email (optional) ===
# EMAIL_PROVIDER=gmail
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_ADDRESS=
# EMAIL_APP_PASSWORD=

# === Execution Schedule ===
EXECUTION_WINDOW_START=09:00
EXECUTION_WINDOW_END=18:00
EXECUTION_TIMEZONE=America/Mexico_City

# === Security ===
SIMULATION_MODE=true  # MUST be true until real execution is authorized
SESSION_TIMEOUT_MINUTES=30
